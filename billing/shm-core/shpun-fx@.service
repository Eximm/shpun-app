[Unit]
Description=Refresh local SHM currency rates for MySQL container %i
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/shm/local-fx/sync_cbr_rates.py --mysql-container=%i
TimeoutStartSec=90
NoNewPrivileges=true
