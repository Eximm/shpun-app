{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:hardcoded": "node scripts/check-hardcoded.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:all": "npm run check:i18n && npm run check:hardcoded && npm run check:security && npm run test:i18n && npm run test:referral && npm run test:register-errors && npm run test:admin-icons && npm run test:monitoring-compact && npm run test:clipboard",
    "test:i18n": "node scripts/test-i18n-runtime.cjs",
    "test:referral": "node scripts/test-referral-capture.mjs",
    "test:register-errors": "node scripts/test-registration-errors.mjs",
    "test:admin-icons": "node scripts/test-admin-icons.mjs",
    "test:monitoring-compact": "node scripts/test-monitoring-compact.mjs",
    "test:clipboard": "node scripts/test-clipboard-attachments.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
