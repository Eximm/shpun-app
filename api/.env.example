PORT=3001
APP_ORIGIN=http://localhost:5173,https://app.shpun.net,https://app.sdnonline.online
COOKIE_SECRET=change-me
SHM_BASE=https://bill.shpyn.online/shm/
SHM_TELEGRAM_PROFILE=ShpynSDNSystem

# SHM 3.x OAuth2. Keep providers empty until the matching provider is
# configured and smoke-tested in SHM. Example after staging: yandex,google
SHM_OAUTH_PROVIDERS=
# Public API base used to build provider callback URLs.
OAUTH_CALLBACK_BASE_URL=https://app.shpun.net/api

REMNAWAVE_HWID_SSH_HOST=corex.shpyn.online
REMNAWAVE_HWID_SSH_USER=shpun-hwid
REMNAWAVE_HWID_SSH_KEY=/opt/shpunapp-secrets/remnawave-hwid
REMNAWAVE_HWID_SSH_KNOWN_HOSTS=/opt/shpunapp-secrets/corex-known-hosts

# Optional comma/space-separated additions to the bundled email-domain allowlist.
EMAIL_ALLOWED_DOMAINS=

SHM_REFERRAL_SECRET=replace-with-a-long-random-secret
