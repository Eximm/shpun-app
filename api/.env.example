EMAIL_ALLOWED_DOMAINS=

SHM_REFERRAL_SECRET=replace-with-a-long-random-secret

# Monitoring 2.0: deployment-level root key for encrypting integration
# credentials (Node Exporter basic auth) at rest.
# AES-256-GCM. Use a 64-char hex or base64 (32-byte) value; any other non-empty
# string is hashed with SHA-256. Changing it makes existing secrets unreadable.
SHPUN_CREDENTIALS_MASTER_KEY=replace-with-a-long-random-secret
